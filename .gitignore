backend/venv/
__pycache__/
node_modules/
.env
.vscode/

# MCP client config: absolute interpreter and script paths, so it is valid on
# exactly one machine. `.mcp.json.example` is the committed copy to copy from —
# same arrangement as `.env` / `.env.example`.
.mcp.json

backend/db.sqlite3
# WAL leaves a write-ahead log and a shared-memory index beside the database.
# They are not covered by the pattern above and are pure local state.
backend/db.sqlite3-wal
backend/db.sqlite3-shm
backend/media/

# collectstatic output: copies of files that already live in the installed
# packages, plus hashed duplicates of each. Rebuilt by the image build.
backend/staticfiles/

# Coverage artefacts: a binary data file and a generated HTML tree. Both are
# rebuilt by `coverage run` / `coverage html` and neither is worth reviewing.
backend/.coverage
backend/htmlcov/

# The OpenAPI schema is generated from the code on every request to
# /api/schema/. Committing a copy would create exactly the drift the generated
# docs exist to prevent — a second description of the API that nothing keeps
# honest.
backend/schema.yml
