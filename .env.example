# Copy to .env before `docker compose up`. .env is gitignored — never commit it.
#
#   cp .env.example .env
#
# This file is for the *container* stack. Running the backend directly with
# `manage.py runserver` still uses backend/.env; the variable names are the same.
#
# Anything describing where files live inside the container (DB_PATH, MEDIA_ROOT,
# REDIS_URL, ALLOWED_HOSTS, CSRF_TRUSTED_ORIGINS) is set in docker-compose.yml
# instead, because those are properties of the deployment rather than choices.

# Required — Django will not start without it. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Which LLM backs each role: stub | anthropic | deepseek
# The defaults keep the whole app working with no API keys and no spend, which is
# also the configuration to demo on if the wifi is unreliable.
EXTRACTION_PROVIDER=stub
MATCHING_PROVIDER=stub

# Only needed if you switch a role off `stub` above.
#
# These are read from the environment and never written into an image — the
# backend .dockerignore excludes .env for exactly this reason. An image with a key
# baked into a layer leaks it to anyone who can pull the image, and `docker
# history` will show it even if a later layer deletes the file.
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
