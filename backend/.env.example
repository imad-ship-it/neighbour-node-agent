# Copy to .env and fill in. .env is gitignored — never commit it.

# Any random string works for development.
SECRET_KEY=replace-with-any-dev-secret
DEBUG=True

# Which LLM backs each role: stub | anthropic | deepseek
# Defaults keep the whole app running with no API keys and no cost.
EXTRACTION_PROVIDER=stub
MATCHING_PROVIDER=stub

# Only needed if you switch a role off `stub` (see README → Configuration).
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# --- Everything below is optional for local development ----------------------
# Sensible defaults are built in, and the container stack sets these itself in
# docker-compose.yml. Listed here so the names are discoverable in one place.

# Required once DEBUG=False: Django rejects any request whose Host header isn't
# listed, and any POST whose Origin isn't trusted. Comma-separated;
# CSRF_TRUSTED_ORIGINS needs the scheme, ALLOWED_HOSTS must not have one.
# ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=http://localhost:8080

# Where the SQLite file and the uploads live. Point these at mounted volumes so
# a rebuild doesn't discard the database or the listing photos.
# DB_PATH=/data/db.sqlite3
# MEDIA_ROOT=/app/media

# Shared cache for the extraction results. Unset falls back to per-process
# LocMemCache, which is fine for runserver and wrong for anything with more than
# one worker — see docs/decisions.md.
# REDIS_URL=redis://redis:6379/0

# Only used by the Vite dev server on its own port; irrelevant behind nginx,
# where the frontend and API share one origin.
# CORS_ALLOWED_ORIGINS=http://localhost:5173
