# Copy to .env to point the frontend at a different backend.
#
# Optional: with no .env at all the app falls back to the local Django dev
# server, so a fresh clone works without configuration.
#
# The VITE_ prefix is required — Vite only exposes variables with it to client
# code, and reads them through import.meta.env, not process.env.
VITE_API_BASE_URL=http://127.0.0.1:8000/api
